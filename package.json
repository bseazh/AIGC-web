{
  "name": "aigc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u NODE_ENV -u __NEXT_PRIVATE_STANDALONE_CONFIG -u __NEXT_PRIVATE_ORIGIN PORT=3010 HOSTNAME=127.0.0.1 next dev",
    "build": "env -u __NEXT_PRIVATE_STANDALONE_CONFIG -u __NEXT_PRIVATE_ORIGIN next build --experimental-build-mode compile",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:regression": "node scripts/regression-check.mjs && node scripts/spokesperson-script.test.mjs && node --experimental-strip-types scripts/douyin-import.test.mjs && node scripts/check-health-alert.test.mjs && node --check scripts/worker.mjs && node --check scripts/moderation-worker.mjs && node --check scripts/wechat-reconcile.mjs && node --check scripts/wechat-pay-acceptance.mjs && node --check scripts/migrate.mjs && node --check scripts/lifecycle-maintenance.mjs",
    "test:db": "node scripts/state-machine-regression.mjs",
    "verify:production": "node scripts/production-preflight.mjs",
    "verify:ark-video": "node scripts/ark-video-acceptance.mjs",
    "verify:admin-exempt": "node scripts/admin-exempt-acceptance.mjs",
    "verify:product-hero": "node scripts/product-hero-acceptance.mjs",
    "verify:real-user-product-hero": "node scripts/real-user-product-hero-acceptance.mjs",
    "verify:wechat-pay": "node scripts/wechat-pay-acceptance.mjs",
    "reconcile:wechat": "node scripts/wechat-reconcile.mjs",
    "report:rollout": "node scripts/gray-rollout-report.mjs",
    "import:yinghai-cases": "node scripts/import-yinghai-cases.mjs"
  },
  "dependencies": {
    "bullmq": "^5.34.10",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.7",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.34.5",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
