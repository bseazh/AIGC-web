[Unit]
Description=Bala AIGC health check with email alert
After=network.target aigc-web.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/project/AIGC_web
EnvironmentFile=-/home/ubuntu/project/AIGC_web/.env.production
ExecStart=/bin/bash /home/ubuntu/project/AIGC_web/scripts/check-health-alert.sh
